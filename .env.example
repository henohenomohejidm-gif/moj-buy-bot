# ============================================
# Telegram
# ============================================

# BotFather token
# NEVER commit the real token to GitHub.
TELEGRAM_BOT_TOKEN=

# Telegram group where the bot posts
TELEGRAM_CHAT_ID=-1004479294741


# ============================================
# Sui Mainnet
# ============================================

SUI_GRAPHQL_URL=https://graphql.mainnet.sui.io/graphql

# Number of recent transactions to inspect
SCAN_LIMIT=50


# ============================================
# MOJ
# ============================================

MOJ_COIN_TYPE=0x04c06ee518a9450ca508fd553e227f509c936b3142f299e66e0038e0c6fb5e8e::moj::MOJ

# Total supply: 100,000,000,000 MOJ
MOJ_TOTAL_SUPPLY=100000000000


# ============================================
# Turbos
# ============================================

TURBOS_PACKAGE=0x96e1396c8a771c8ae404b86328dc27e7b66af39847a31926980c96dbc1096a15

TURBOS_BUY_FUNCTION=0x96e1396c8a771c8ae404b86328dc27e7b66af39847a31926980c96dbc1096a15::turbospump::buy

MOJ_POOL_ID=0xe2834b740618ee4bf267a18635cc4d56b250f33d6c618ad10cae9fe796dcd3cd


# ============================================
# SUI/USD
# ============================================

# SUI/USD is fetched automatically from CoinGecko.
# No SUI_USD_PRICE environment variable is required.


# ============================================
# Upstash Redis
# ============================================

# Required for duplicate-notification protection.
UPSTASH_REDIS_REST_URL=

UPSTASH_REDIS_REST_TOKEN=


# ============================================
# Optional
# ============================================

# If set, /api/check requires:
# Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
