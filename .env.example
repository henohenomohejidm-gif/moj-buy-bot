# Telegram BotFather token
TELEGRAM_BOT_TOKEN=123456789:REPLACE_ME

# Telegram group/channel where the bot posts
TELEGRAM_CHAT_ID=@henohenomohejicoin

# Sui GraphQL endpoint. The public endpoint is rate-limited; for production use a provider endpoint.
SUI_GRAPHQL_URL=https://graphql.mainnet.sui.io/graphql

# Exact MOJ Coin Type
MOJ_COIN_TYPE=0x04c06ee518a9450ca508fd553e227f509c936b3142f299e66e0038e0c6fb5e8e::moj::MOJ

# How many latest programmable transactions to inspect per cron run.
SCAN_LIMIT=100

# Optional: prevents small transfers from being announced as buys.
MIN_MOJ_AMOUNT=0
MIN_SUI_AMOUNT=0

# Optional. Set total MOJ supply in whole tokens to show Market Cap.
# Example: 1000000000
MOJ_TOTAL_SUPPLY=

# Optional SUI/USD price. If blank, the bot fetches CoinGecko's public simple price endpoint.
SUI_USD_PRICE=

# Optional project links
MOJ_WEB_URL=https://henohenomoheji.tok.best/
MOJ_X_URL=https://x.com/MOHEJI_MOJ
MOJ_TG_URL=https://t.me/heno_henomoheji

# Optional Upstash Redis. Connect a Redis integration in Vercel and paste these values.
# Without Redis, the bot still works but duplicate notifications can happen between cron runs.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional secret for manually calling /api/check outside Vercel Cron.
CRON_SECRET=
